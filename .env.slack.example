# ==========================================
# ImpactPulse — Slack App Environment Configuration
# ==========================================

# 1. Slack App Credentials (from https://api.slack.com/apps -> Basic Information -> App Credentials)
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# 2. Slack Bot Token (from OAuth & Permissions -> Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# 3. Optional: Slack App-Level Token (Required only if running Socket Mode instead of HTTP webhooks)
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# 4. Web Deployment URL (Used in Action URLs & Webhook Callbacks)
APP_URL=https://ap-27-df-26-impact-pulse-hack02.vercel.app
NEXT_PUBLIC_APP_URL=https://ap-27-df-26-impact-pulse-hack02.vercel.app

# 5. Target Stakeholder IDs (for Direct Message Escalations)
SLACK_SAM_USER_ID=U0C06KZRT6V
SLACK_ANU_USER_ID=U0C0Z3RAKQ8
